[Unit]
Description=Synapse API
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart={{BUN}} run --cwd {{REPO}}/apps/api start
Environment=PATH={{PATH}}
Environment=SYNAPSE_DB_PATH={{DB_PATH}}
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
